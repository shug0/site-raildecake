// Worker Cloudflare sans code : il sert public/index.html.
{
  "name": "raildecake",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "raildecake.fr", "custom_domain": true },
    { "pattern": "www.raildecake.fr", "custom_domain": true }
  ]
}
